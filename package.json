{
  "name": "vue-nnn-router",
  "version": "0.0.9",
  "description": "File-based SPA routing for Vue Router 4–5 — build RouteRecordRaw from Vite import.meta.glob (index.vue, _layout.vue, _redirect.ts, [param], _middleware cascade).",
  "homepage": "https://github.com/theanh-it/vue-nnn-router#readme",
  "bugs": {
    "url": "https://github.com/theanh-it/vue-nnn-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theanh-it/vue-nnn-router.git"
  },
  "type": "module",
  "main": "./dist/vue-nnn-router.cjs",
  "module": "./dist/vue-nnn-router.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-nnn-router.js",
      "require": "./dist/vue-nnn-router.cjs"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js",
      "require": "./dist/progress.cjs"
    },
    "./smooth-scroll": {
      "types": "./dist/smoothScroll.d.ts",
      "import": "./dist/smooth-scroll.js",
      "require": "./dist/smooth-scroll.cjs"
    },
    "./vite": {
      "types": "./dist/vitePlugin.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.vi.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.config.progress.ts && vite build --config vite.config.smooth-scroll.ts && vite build --config vite.config.smooth-scroll-cjs.ts && vite build --config vite.config.vite.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:package": "node ./scripts/check-package.mjs && tsc -p test-package/tsconfig.json",
    "prepack": "npm run build && npm run test:package",
    "prepublishOnly": "npm test && npm run typecheck",
    "demo:dev": "npm --prefix ./demo run dev",
    "demo:install": "npm --prefix ./demo install",
    "demo:build": "npm --prefix ./demo run build",
    "demo:gen-names": "node --input-type=module -e \"import { generateRouterNameFile } from './dist/vite.js'; import { resolve } from 'node:path'; generateRouterNameFile({ root: resolve('demo'), pages: ['src/pages/**/*.{vue,tsx,jsx,ts,js}', 'src/pages/**/_middleware.ts', 'src/pages/**/_redirect.ts'], routesRoot: 'src/pages', outFile: 'src/router/router-name.ts', silent: true });\""
  },
  "keywords": [
    "vite",
    "vue",
    "vue-router",
    "vue-router-4",
    "vue-router-5",
    "file-based-router",
    "glob",
    "import-meta-glob",
    "spa-routing",
    "directory-router",
    "middleware",
    "layout",
    "redirect",
    "smooth-scroll",
    "lenis"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "tinyglobby": "^0.2.14"
  },
  "peerDependencies": {
    "lenis": "^1.3.26",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "lenis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "lenis": "^1.3.26",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "vue": "^3.5.16",
    "vue-router": "^4.6.4"
  }
}
